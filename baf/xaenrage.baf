IF 
    Global("XA_ST_SlayerTransformRomance", "GLOBAL", 1)
THEN
    RESPONSE #100
        SetInterrupt(FALSE)
        ActionOverride(Player1, ReallyForceSpellRES("SPIN823", Myself))
        DisplayStringHead(Player1, @0)
		SetGlobal("XA_ST_TriggerRepPenalty", "GLOBAL", 1)
        SetGlobal("XA_ST_SlayerTransformRomance", "GLOBAL", 0)
        SetInterrupt(TRUE)
        Continue()
END